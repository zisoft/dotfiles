;; https://github.com/jtroo/kanata/discussions/1455

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  caps a s d f j k l ;
)

(deftemplate charmod (char mod)
  (switch
    ((key-timing 3 less-than 250)) $char break
    () (tap-hold-release-timeout 200 400 $char $mod $char) break
  )
)

(deflayermap (main)
  caps (tap-hold 200 200 esc (multi lalt lmet lctl))    ;; caps --> hyper
  a (t! charmod a ralt)
  s (t! charmod s lmet)
  d (t! charmod d lsft)
  f (t! charmod f lctl)
  j (t! charmod j rctl)
  k (t! charmod k rsft)
  l (t! charmod l rmet)
  ; (t! charmod ; ralt)
)

(defchordsv2
  (a f) (layer-while-held nav) 500 first-release ()
)

(deflayermap (nav)
  h left
  j down
  k up
  l right
)

