macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
title = " "

window-width = 180
window-height = 60
window-position-x = 450
window-position-y = 20

confirm-close-surface = false
quit-after-last-window-closed = true

theme = Catppuccin Frappe

font-size = 12
font-feature = -dlig
font-feature = -liga
font-feature = -calt

cursor-style-blink = false

unfocused-split-opacity = 1

macos-option-as-alt = left

# tmux keybindings for splits
keybind = ctrl+b>shift+5=new_split:right
keybind = ctrl+b>shift+2=new_split:down
keybind = ctrl+b>c=new_tab

# Navigation
# Outside Neovim.
# Move
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

# Resize
keybind = performable:ctrl+shift+h=resize_split:left,30
keybind = performable:ctrl+shift+j=resize_split:down,30
keybind = performable:ctrl+shift+k=resize_split:up,30
keybind = performable:ctrl+shift+l=resize_split:right,30

# Inside Neovim.
keybind =  nvim/
# Move
keybind =  nvim/ctrl+h=text:\x08
keybind =  nvim/ctrl+j=text:\x0a
keybind =  nvim/ctrl+k=text:\x0b
keybind =  nvim/ctrl+l=text:\x0c

# Resize
keybind =  nvim/ctrl+shift+h=esc:h
keybind =  nvim/ctrl+shift+j=esc:j
keybind =  nvim/ctrl+shift+k=esc:k
keybind =  nvim/ctrl+shift+l=esc:l
